# Copy to .env and fill in (.env is ignored by git)
LOG_LEVEL=INFO
AWS_REGION=eu-west-1
KINESIS_STREAM_NAME=energy-sensor-events-dev

# Databricks (optional: /databricks and databricks_job pipeline tasks return 503 when missing)
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=

# Pipeline orchestration
PIPELINES_CONFIG_PATH=config/pipelines.yaml
TRACKING_BACKEND=memory              # memory = no AWS needed locally | dynamodb = the real tracking table
TRACKING_TABLE_NAME=energy-pipeline-runs-dev
POLL_INTERVAL_S=15
DEFAULT_TASK_TIMEOUT_MIN=60
